# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=

# ─── Worker Runtime (canonical names) ────────────────────────────────────────
# RPC endpoint for the Arc network (required by worker)
CHAIN_RPC_URL=

# Chain ID for RPC verification at worker startup
CHAIN_ID=5042002

# Relay operator private key (64 hex chars, with or without 0x prefix)
SPONSOR_PRIVATE_KEY=

# Deployed contract addresses
CONTRACT_ADDRESS_SPONSOR_VAULT=
CONTRACT_ADDRESS_SPONSORSHIP_REGISTRY=

# ─── Legacy Aliases (backward compatible, used as fallbacks) ─────────────────
# ARC_RPC_URL is accepted as a fallback for CHAIN_RPC_URL
ARC_RPC_URL=

# DEPLOYER_PRIVATE_KEY is accepted as a fallback for SPONSOR_PRIVATE_KEY
DEPLOYER_PRIVATE_KEY=

# ─── Contract Deployment (Foundry/Forge only) ────────────────────────────────
SPONSOR_VAULT_ADDRESS=
SPONSORSHIP_REGISTRY_ADDRESS=

# ─── Optional Worker Tuning ──────────────────────────────────────────────────
# POLL_INTERVAL_MS=5000
# BATCH_SIZE=20
# MAX_RETRIES=5
# LOCK_TIMEOUT_MS=30000
# SHUTDOWN_TIMEOUT_MS=10000
# TX_TIMEOUT_MS=120000
# CONFIRMATION_BLOCKS=2
# SPONSORSHIP_AMOUNT_WEI=1000000000000000
# CHAIN_ID_VERIFY_TIMEOUT_MS=10000
# EXPLORER_BASE_URL=https://testnet.arcscan.app/tx/
